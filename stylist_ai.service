[Unit]
Description=Stylist AI Gunicorn Service
After=network.target

[Service]
User=thunderhunt
Group=thunderhunt
WorkingDirectory=/home/thunderhunt/app
Environment="PATH=/home/thunderhunt/app/venv/bin"
ExecStart=/home/thunderhunt/app/venv/bin/gunicorn --config gunicorn_config.py app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target 