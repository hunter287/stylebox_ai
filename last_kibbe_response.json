{
  "body_features": "\u043d\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u044b", 
  "description": "\u0436\u0435\u043d\u0449\u0438\u043d\u0430 \u0441 \u043e\u0432\u0430\u043b\u044c\u043d\u044b\u043c \u043b\u0438\u0446\u043e\u043c, \u0432\u044b\u0440\u0430\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c\u0438 \u0441\u043a\u0443\u043b\u0430\u043c\u0438, \u043f\u043e\u043b\u043d\u044b\u043c\u0438 \u0433\u0443\u0431\u0430\u043c\u0438 \u0438 \u0431\u043e\u043b\u044c\u0448\u0438\u043c\u0438 \u0433\u043b\u0430\u0437\u0430\u043c\u0438", 
  "face_features": "\u0444\u043e\u0440\u043c\u0430 \u043b\u0438\u0446\u0430 \u043e\u0432\u0430\u043b\u044c\u043d\u0430\u044f, \u0441\u043a\u0443\u043b\u044b \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0435, \u043f\u043e\u0434\u0431\u043e\u0440\u043e\u0434\u043e\u043a \u043c\u044f\u0433\u043a\u0438\u0439, \u0433\u0443\u0431\u044b \u043f\u043e\u043b\u043d\u044b\u0435, \u0433\u043b\u0430\u0437\u0430 \u0431\u043e\u043b\u044c\u0448\u0438\u0435", 
  "horizontal_lines": "\u043d\u0435\u0439\u0442\u0440\u0430\u043b\u044c\u043d\u044b\u0435", 
  "kibbe_type": "\u041a\u043b\u0430\u0441\u0441\u0438\u043a", 
  "style_recommendations": "\u043f\u043e\u0434\u0447\u0435\u0440\u043a\u043d\u0443\u0442\u044c \u0433\u043b\u0430\u0437\u0430 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043c\u0430\u043a\u0438\u044f\u0436\u0430, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0430\u043a\u0441\u0435\u0441\u0441\u0443\u0430\u0440\u044b, \u0442\u0430\u043a\u0438\u0435 \u043a\u0430\u043a \u043a\u0440\u0443\u043f\u043d\u044b\u0435 \u0441\u0435\u0440\u044c\u0433\u0438, \u0432\u044b\u0431\u0438\u0440\u0430\u0442\u044c \u043e\u0434\u0435\u0436\u0434\u0443 \u0441 \u043e\u0442\u043a\u0440\u044b\u0442\u044b\u043c \u0432\u0435\u0440\u0445\u043e\u043c", 
  "vertical_lines": "\u043d\u0435 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u044b"
